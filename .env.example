# =============================================================================
# Agente de Licitações — variáveis de ambiente
# Copie para .env e ajuste. O arquivo .env NÃO deve ser versionado.
# =============================================================================

AMBIENTE=desenvolvimento
LOG_LEVEL=INFO

# --- API do monitor (projeto Node monitor-licitacoes-IA) --------------------
MONITOR_API_URL=http://127.0.0.1:3333
# Precisa ser o MESMO valor de API_TOKEN do .env do projeto Node.
# Sem o token, o agente só consegue ler dados (não envia digest).
MONITOR_API_TOKEN=troque-por-um-token-longo-e-aleatorio
MONITOR_TIMEOUT_SEGUNDOS=20
# Tempo de cache local dos dados do monitor (evita bater na API a cada pergunta).
MONITOR_CACHE_TTL_SEGUNDOS=60

# --- LLM --------------------------------------------------------------------
# Opções: fake (determinístico, sem custo, ideal para testar) | openai_compativel
LLM_PROVIDER=fake
LLM_MODELO=gpt-4o-mini
LLM_API_KEY=
# O provedor "openai_compativel" funciona com OpenAI, DeepSeek, Groq, Together,
# Ollama (http://localhost:11434/v1) e LM Studio — basta trocar a base URL.
#
# DeepSeek (nomes de modelo atuais: deepseek-flash | deepseek-v4-pro):
#   LLM_PROVIDER=openai_compativel
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODELO=deepseek-flash
#   LLM_MODO_PENSAMENTO=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURA=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SEGUNDOS=60
LLM_MAX_TENTATIVAS=2
# Modo de raciocínio (dialeto do DeepSeek): auto | enabled | disabled
#   auto     → não envia o campo (compatível com OpenAI, Groq etc.)
#   disabled → desliga o raciocínio: mais rápido, mais barato, respeita a
#              temperatura e não gasta max_tokens com a cadeia de pensamento
#   enabled  → raciocínio ligado (melhor em perguntas complexas, mais caro)
LLM_MODO_PENSAMENTO=auto

# --- Contexto enviado ao modelo --------------------------------------------
CONTEXTO_MAX_LICITACOES=150
CONTEXTO_MAX_CARACTERES_OBJETO=240

# --- Servidor HTTP do agente ------------------------------------------------
AGENTE_HOST=127.0.0.1
AGENTE_PORT=8000

# --- Digest proativo --------------------------------------------------------
DIGEST_DIAS_PADRAO=7
